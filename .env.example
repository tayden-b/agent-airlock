# Airlock runs with no credentials at all. Every variable here is optional.

# libsql URL for the local database (default: file:./data/airlock.db)
AIRLOCK_DATABASE_URL=file:./data/airlock.db

# Classifier providers, in order. "rules" is deterministic and always available.
# Add "jev" once the TypeSafe provider (PR 2) is implemented: AIRLOCK_CLASSIFIER=rules,jev
AIRLOCK_CLASSIFIER=rules

# TypeSafe Jev API key (PR 2). Never commit a real value. In Devin, store it as a Secret.
TYPESAFE_API_KEY=

# Record raw hook payloads to .airlock/recordings/*.jsonl for fixtures and replay (PR 3).
AIRLOCK_RECORD_RAW=0
